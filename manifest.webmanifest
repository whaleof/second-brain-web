{
  "name": "第二大脑",
  "short_name": "第二大脑",
  "description": "个人知识管理与生产力工作台",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFF5F7",
  "theme_color": "#F4A6B5",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share.html",
    "method": "GET",
    "params": {
      "query": {
        "url": "url",
        "text": "text"
      }
    }
  },
  "shortcuts": [
    {
      "name": "消化剪贴板链接",
      "short_name": "消化剪贴板",
      "description": "读取剪贴板中的抖音/视频链接并触发消化（避开抖音分享面板限制）",
      "url": "./share.html?mode=clipboard",
      "icons": [
        { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "打开工作台",
      "short_name": "打开",
      "url": "./index.html",
      "icons": [
        { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ]
}
